# ==============================================================================
# AI Real Estate Marketing & Business Automation Studio - Environment Variables
# ==============================================================================
# Copy this file to .env or .env.local to configure live API keys.
# If no keys are provided, the studio automatically runs in high-fidelity MOCK MODE
# allowing complete local testing and demonstration with realistic data fixtures.

# ------------------------------------------------------------------------------
# AI Provider Configuration (Google Gemini)
# ------------------------------------------------------------------------------
# Current recommended models: gemini-3.7-flash (strategy/copy), gemini-3.5-flash-lite (fast)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.7-flash

# Image Generation (Optional AI illustrative concepts)
# Models: gemini-3.1-flash-image-preview, gemini-3-pro-image-preview
VITE_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ------------------------------------------------------------------------------
# Alternative Image Provider (NVIDIA Hosted NIM / Flux / SDXL)
# ------------------------------------------------------------------------------
VITE_NVIDIA_API_KEY=
VITE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# Future Backend & Persistence (Supabase)
# ------------------------------------------------------------------------------
# When transitioning from local storage to cloud persistence:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Mode Settings
# ------------------------------------------------------------------------------
VITE_DEFAULT_AI_PROVIDER=auto # 'auto' | 'gemini' | 'mock'
VITE_DEFAULT_IMAGE_PROVIDER=upload # 'upload' | 'gemini' | 'nvidia' | 'mock'
